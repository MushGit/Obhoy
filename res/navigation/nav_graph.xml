<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/profileSetupFragment">

    <fragment
        android:id="@+id/profileSetupFragment"
        android:name="com.obhoy.app.ui.onboarding.ProfileSetupFragment"
        android:label="Profile Setup"
        tools:layout="@layout/fragment_profile_setup">
        <action
            android:id="@+id/action_profileSetupFragment_to_contactsFragment"
            app:destination="@id/contactsFragment" />
    </fragment>

    <fragment
        android:id="@+id/contactsFragment"
        android:name="com.obhoy.app.ui.onboarding.ContactsSetupFragment"
        android:label="Emergency Contacts"
        tools:layout="@layout/fragment_contact_management">
        <action
            android:id="@+id/action_contactsFragment_to_pinSetupFragment"
            app:destination="@id/pinSetupFragment" />
    </fragment>

    <fragment
        android:id="@+id/pinSetupFragment"
        android:name="com.obhoy.app.ui.onboarding.PinSetupFragment"
        android:label="PIN Setup"
        tools:layout="@layout/fragment_pin_setup" />

</navigation>
